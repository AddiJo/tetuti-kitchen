{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/i/:token([a-f0-9]{32})/:file(INV-[0-9]{8}-[0-9]+\\.pdf)",
      "destination": "https://vmqrwjzjxetjbrqfhnhr.supabase.co/storage/v1/object/public/invoice-pdf/:token/:file"
    }
  ],
  "headers": [
    {
      "source": "/i/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
